---
import View from '../../../views/UpdateDetail.astro';
import { getUpdates } from '../../../lib/content';
export async function getStaticPaths() {
  return (await getUpdates()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<View lang="te" entry={entry} />
