---
import Base from '../layouts/Base.astro';
import { ui, href, pick, type Lang } from '../i18n';
import settings from '../data/settings.json';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<Base lang={lang} title={t.nav.about}>
  <div class="page-head"><div class="container"><h1>{t.nav.about}</h1></div></div>
  <section class="section">
    <div class="container grid g2">
      <div class="card pad"><h2>{t.mission}</h2><p>{pick(lang, settings.mission, settings.mission_te)}</p></div>
      <div class="card pad"><h2>{t.vision}</h2><p>{pick(lang, settings.vision, settings.vision_te)}</p></div>
    </div>
  </section>
  <section class="section alt">
    <div class="container"><h2>{t.story}</h2><p class="lead">{pick(lang, settings.story, settings.story_te)}</p></div>
  </section>
  <section class="section">
    <div class="container">
      <h2>{t.team}</h2>
      <div class="grid g3 team">
        {settings.team.map((m) => (
          <div class="card pad center">
            {m.photo ? <img class="avatar" src={m.photo} alt="" /> : <div class="avatar">{pick(lang, m.name, m.name_te).replace(/^\[[^\]]*\]\s*/, '').charAt(0)}</div>}
            <h3 style="margin:0">{pick(lang, m.name, m.name_te)}</h3>
            <p class="muted" style="margin:0">{pick(lang, m.role, m.role_te)}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a class="btn btn-green" href={href(lang, '/transparency')}>{t.seeTransparency}</a></p>
    </div>
  </section>
</Base>
