---
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import { ui, pick, formatDate, type Lang } from '../i18n';
const { lang, page } = Astro.props as { lang: Lang; page: 'privacy' | 'terms' | 'refund' };
const t = ui[lang];
const entry = await getEntry('legal', page);
if (!entry) throw new Error(`Missing src/content/legal/${page}.md`);
const d = entry.data;
const md = lang === 'te' && d.body_te ? d.body_te : entry.body ?? '';
const html = marked.parse(md, { async: false }) as string;
const title = pick(lang, d.title, d.title_te);
---
<Base lang={lang} title={title}>
  <div class="page-head"><div class="container"><h1>{title}</h1></div></div>
  <section class="section">
    <div class="container">
      <p><span class="legal-badge">{t.draft}</span> <span class="muted small">{t.updated}: {formatDate(lang, d.updated)}</span></p>
      <div class="prose" set:html={html} />
    </div>
  </section>
</Base>
