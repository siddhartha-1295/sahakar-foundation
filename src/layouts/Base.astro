---
import '../styles/global.css';
import { ui, href, switchLangPath, type Lang } from '../i18n';
import settings from '../data/settings.json';

interface Props { lang: Lang; title?: string; description?: string; image?: string; }
const { lang, title, description, image } = Astro.props as Props;
const t = ui[lang];
const pathname = Astro.url.pathname;
const siteName = lang === 'te' && settings.name_te ? settings.name_te : settings.name;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const desc = description ?? (lang === 'te' ? settings.tagline_te : settings.tagline);
const otherLang: Lang = lang === 'en' ? 'te' : 'en';
const otherPath = switchLangPath(pathname, lang);
const trim = (p: string) => p.replace(/\/+$/, '') || '/';
const nav = [['home', '/'], ['about', '/about'], ['work', '/work'], ['updates', '/updates'], ['gallery', '/gallery'], ['events', '/events'], ['contact', '/contact']] as const;
const isActive = (p: string) => {
  const h = trim(href(lang, p)); const cur = trim(pathname);
  return p === '/' ? cur === h : cur === h || cur.startsWith(h + '/');
};
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
const wa = `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent('Hello ' + settings.name)}`;
const social = Object.entries(settings.social).filter(([, v]) => v) as [string, string][];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang={lang} href={pathname} />
    <link rel="alternate" hreflang={otherLang} href={otherPath} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Telugu:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {settings.analytics_token && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: settings.analytics_token })}></script>}
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={href(lang, '/')}><img src="/favicon.svg" alt="" /><span>{siteName}</span></a>
        <a class="lang-link" href={otherPath} hreflang={otherLang} lang={otherLang}>{t.switchLabel}</a>
        <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="nav">☰ {t.menu}</button>
        <nav class="nav" id="nav" aria-label="Main">
          {nav.map(([k, p]) => <a class={'link' + (isActive(p) ? ' active' : '')} href={href(lang, p)}>{t.nav[k]}</a>)}
          <div class="btns">
            <a class="btn btn-outline btn-sm" href={href(lang, '/get-involved')}>{t.volunteer}</a>
            <a class="btn btn-primary btn-sm" href={href(lang, '/donate')}>❤ {t.donate}</a>
          </div>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h3>{siteName}</h3>
            <p>{lang === 'te' ? settings.tagline_te : settings.tagline}</p>
          </div>
          <div>
            <h3>{t.quickLinks}</h3>
            <ul>
              {nav.slice(1).map(([k, p]) => <li><a href={href(lang, p)}>{t.nav[k]}</a></li>)}
              <li><a href={href(lang, '/get-involved')}>{t.volunteer}</a></li>
              <li><a href={href(lang, '/donate')}>{t.donate}</a></li>
              <li><a href={href(lang, '/transparency')}>{lang === 'te' ? 'పారదర్శకత' : 'Transparency'}</a></li>
            </ul>
          </div>
          <div>
            <h3>{t.contactUs}</h3>
            <ul>
              <li>📍 {lang === 'te' && settings.address_te ? settings.address_te : settings.address}</li>
              <li>📞 <a href={`tel:${settings.phone.replace(/\s/g, '')}`}>{settings.phone}</a></li>
              <li>✉️ <a href={`mailto:${settings.email}`}>{settings.email}</a></li>
            </ul>
            {social.length > 0 && (<><h3 style="margin-top:1rem">{t.followUs}</h3><ul>{social.map(([k, v]) => <li><a href={v} target="_blank" rel="noopener">{k.charAt(0).toUpperCase() + k.slice(1)}</a></li>)}</ul></>)}
          </div>
          <div>
            <h3>{t.policies}</h3>
            <ul>
              <li><a href={href(lang, '/privacy')}>{t.privacy}</a></li>
              <li><a href={href(lang, '/terms')}>{t.terms}</a></li>
              <li><a href={href(lang, '/refund')}>{t.refund}</a></li>
            </ul>
          </div>
        </div>
        <div class="copyright">© {year} {siteName}. {t.rights}</div>
      </div>
    </footer>

    <a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label={t.whatsapp} title={t.whatsapp}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.04 3C8.84 3 3 8.8 3 15.95c0 2.28.6 4.5 1.74 6.46L3 29l6.78-1.7a13.1 13.1 0 0 0 6.26 1.6C23.2 28.9 29 23.1 29 15.95 29 8.8 23.2 3 16.04 3zm0 23.7c-1.95 0-3.86-.52-5.53-1.5l-.4-.23-4.02 1 1.07-3.9-.26-.4a10.6 10.6 0 0 1-1.63-5.7c0-5.86 4.8-10.6 10.77-10.6 5.9 0 10.7 4.74 10.7 10.6 0 5.85-4.8 10.73-10.7 10.73zm5.9-7.9c-.32-.16-1.9-.93-2.2-1.04-.3-.1-.5-.16-.72.16-.2.32-.83 1.04-1.02 1.26-.19.2-.38.24-.7.08-.33-.16-1.37-.5-2.6-1.6-.96-.85-1.6-1.9-1.8-2.22-.18-.32-.02-.5.14-.66.15-.14.33-.37.5-.56.15-.19.2-.32.3-.54.1-.2.05-.4-.03-.56-.08-.16-.72-1.72-.98-2.36-.26-.62-.52-.54-.72-.55h-.6c-.2 0-.55.08-.84.4-.3.32-1.1 1.07-1.1 2.6s1.13 3.02 1.28 3.23c.16.2 2.2 3.4 5.4 4.76.76.33 1.36.52 1.82.67.76.24 1.46.2 2 .12.62-.1 1.9-.78 2.17-1.53.27-.75.27-1.4.2-1.53-.08-.13-.3-.2-.62-.37z"/></svg>
    </a>

    <div id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
      <button class="x" aria-label="Close">×</button><button class="pv" aria-label="Previous">‹</button><button class="nx" aria-label="Next">›</button>
      <img alt="" /><p></p>
    </div>

    <script>
      // Mobile menu
      const btn = document.getElementById('menuBtn');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });

      // Lightbox for any a[data-lightbox] (links with the same value form one gallery)
      const lb = document.getElementById('lb') as HTMLElement;
      const lbImg = lb.querySelector('img') as HTMLImageElement;
      const lbCap = lb.querySelector('p') as HTMLElement;
      let list: HTMLAnchorElement[] = [];
      let idx = 0;
      const show = () => {
        const a = list[idx];
        lbImg.src = a.href; lbImg.alt = a.querySelector('img')?.alt || '';
        lbCap.textContent = a.dataset.caption || '';
      };
      const close = () => lb.classList.remove('open');
      const step = (n: number) => { idx = (idx + n + list.length) % list.length; show(); };
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a[data-lightbox]') as HTMLAnchorElement | null;
        if (!a) return;
        e.preventDefault();
        list = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')).filter((x) => x.dataset.lightbox === a.dataset.lightbox);
        idx = list.indexOf(a); show(); lb.classList.add('open');
      });
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      lb.querySelector('.x')?.addEventListener('click', close);
      lb.querySelector('.pv')?.addEventListener('click', () => step(-1));
      lb.querySelector('.nx')?.addEventListener('click', () => step(1));
      document.addEventListener('keydown', (e) => {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape') close(); if (e.key === 'ArrowLeft') step(-1); if (e.key === 'ArrowRight') step(1);
      });

      // Local testing only: Netlify forms cannot receive POSTs on localhost, so go straight to the thank-you page.
      if (['localhost', '127.0.0.1'].includes(location.hostname)) {
        document.querySelectorAll<HTMLFormElement>('form[data-netlify]').forEach((f) =>
          f.addEventListener('submit', (e) => { e.preventDefault(); if (f.reportValidity()) location.href = f.getAttribute('action') || '/'; })
        );
      }
    </script>
  </body>
</html>
